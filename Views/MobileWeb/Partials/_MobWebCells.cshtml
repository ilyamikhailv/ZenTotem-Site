@* Блок cells — Figma 37879:912 (Мобильный веб). Родитель: Views/MobileWeb/Index.cshtml. Стили:
wwwroot/css/blocks/mob-web-cells/mob-web-cells.css. *@
<section class="mob-web-cells" aria-label="Возможности таргетинга">
  <div class="mob-web-cells__inner">
    <h2 class="mob-web-cells__heading">
      Возможности таргетинга<br />
      для 60 000 000<br />
      <span>уникальных пользователей</span>
    </h2>
    <div class="mob-web-cells__grid">
      <article class="mob-web-cells__card mob-web-cells__card--portrait">
        <h3 class="mob-web-cells__card-title mob-web-cells__card-title--portrait">
          Портрет<br />
          пользователя
        </h3>
        <p class="mob-web-cells__card-lead">
          Контроль охвата и частоты<br />
          взаимодействия с пользователем
        </p>
      </article>
      <article class="mob-web-cells__card mob-web-cells__card--loyalty">
        <h3 class="mob-web-cells__card-title mob-web-cells__card-title--loyalty">
          Потребительская<br />
          лояльность
        </h3>
        <ul class="mob-web-cells__list">
          <li class="mob-web-cells__list-item">
            <img
              class="mob-web-cells__list-icon"
              src="~/css/blocks/mob-web-cells/mob-web-cells-check.svg"
              width="24"
              height="24"
              alt=""
            />
            <span>Восприимчивость к кросс- и апселлингу</span>
          </li>
          <li class="mob-web-cells__list-item">
            <img
              class="mob-web-cells__list-icon"
              src="~/css/blocks/mob-web-cells/mob-web-cells-check.svg"
              width="24"
              height="24"
              alt=""
            />
            <span>Частота и регулярность покупок</span>
          </li>
          <li class="mob-web-cells__list-item">
            <img
              class="mob-web-cells__list-icon"
              src="~/css/blocks/mob-web-cells/mob-web-cells-check.svg"
              width="24"
              height="24"
              alt=""
            />
            <span>
              Индекс лояльности к продуктовым<br />
              категориям
            </span>
          </li>
        </ul>
      </article>
      <article class="mob-web-cells__card mob-web-cells__card--finance">
        <div class="mob-web-cells__card-finance-bg" aria-hidden="true"></div>
        <div class="mob-web-cells__card-finance-inner">
          <h3 class="mob-web-cells__card-title mob-web-cells__card-title--finance">Финансовый профиль</h3>
          <p class="mob-web-cells__card-desc mob-web-cells__card-desc--finance">
            Включает в себя уровень дохода,<br />
            динамику трат и инвестиционный профиль
          </p>
        </div>
      </article>
      <article class="mob-web-cells__card mob-web-cells__card--predictive">
        <div class="mob-web-cells__predictive-tabs" role="presentation">
          <span class="mob-web-cells__predictive-tab mob-web-cells__predictive-tab--active" aria-hidden="true"></span>
          <span class="mob-web-cells__predictive-tab" aria-hidden="true"></span>
          <span class="mob-web-cells__predictive-tab" aria-hidden="true"></span>
          <span class="mob-web-cells__predictive-tab" aria-hidden="true"></span>
        </div>
        <p class="mob-web-cells__predictive-sub">Дополнительные возможности</p>
        <h3 class="mob-web-cells__card-title mob-web-cells__card-title--predictive">
          Предиктивный<br />
          интерес
        </h3>
        <p class="mob-web-cells__predictive-body">
          Анализируем микро-сигналы поведения пользовательских сегментов и предсказываем готовность к покупке вашего
          бренда на базе<br />
          AI-инструментов
        </p>
      </article>
    </div>
  </div>
</section>
