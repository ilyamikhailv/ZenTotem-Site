<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Site</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;500&family=Montserrat:wght@400;500;600;800&display=swap" rel="stylesheet"/>
    <environment include="Development">
        <link rel="stylesheet" href="~/css/base/variables.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/base/typography.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/base/page.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/site-header/site-header.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/site-footer/site-footer.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/main-hero/main-hero.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/main-metrics/main-metrics.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/main-segments/main-segments.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/main-technologies/main-technologies.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/main-features/main-features.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/demo-cabinet/demo-cabinet.css" asp-append-version="true"/>
        <link rel="stylesheet" href="~/css/blocks/request-platform-access/request-platform-access-button.css" asp-append-version="true"/>
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/site.bundle.min.css" asp-append-version="true"/>
    </environment>
</head>
<body>
<partial name="_Header"/>
<main>
    @RenderBody()
</main>
<partial name="_Footer"/>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
