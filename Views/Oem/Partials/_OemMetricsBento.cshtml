@* Блок метрик (bento) — Figma Frame 1597879854 (37879:1288). Родитель: Views/Oem/Index.cshtml.
   Стили: wwwroot/css/blocks/oem-metrics-bento/oem-metrics-bento.css. *@
<section class="oem-metrics-bento" aria-label="Метрики OEM">
  <div class="oem-metrics-bento__inner">
    <div class="oem-metrics-bento__grid">
      <div class="oem-metrics-bento__cell oem-metrics-bento__cell--tracking">
        <div class="oem-metrics-bento__tracking-board">
          <div class="oem-metrics-bento__tracking-lines" aria-hidden="true">
            <span class="oem-metrics-bento__tracking-line oem-metrics-bento__tracking-line--horizontal"></span>
            <span class="oem-metrics-bento__tracking-line oem-metrics-bento__tracking-line--vertical"></span>
          </div>
          <img
            class="oem-metrics-bento__tracking-logo oem-metrics-bento__tracking-logo--appsflyer"
            src="~/css/blocks/oem-metrics-bento/oem-metrics-tracking-appsflyer.svg"
            width="222"
            height="60"
            alt="AppsFlyer"
          />
          <img
            class="oem-metrics-bento__tracking-logo oem-metrics-bento__tracking-logo--branch"
            src="~/css/blocks/oem-metrics-bento/oem-metrics-tracking-branch.svg"
            width="155"
            height="60"
            alt="Branch"
          />
          <img
            class="oem-metrics-bento__tracking-logo oem-metrics-bento__tracking-logo--appmetrica"
            src="~/css/blocks/oem-metrics-bento/oem-metrics-tracking-appmetrica.svg"
            width="293"
            height="48"
            alt="AppMetrica"
          />
          <img
            class="oem-metrics-bento__tracking-logo oem-metrics-bento__tracking-logo--adjust"
            src="~/css/blocks/oem-metrics-bento/oem-metrics-tracking-adjust.svg"
            width="195"
            height="60"
            alt="Adjust"
          />
        </div>
        <p class="oem-metrics-bento__tracking-caption">Полная поддержка внешнего трекинга</p>
      </div>

      <div class="oem-metrics-bento__cell oem-metrics-bento__cell--visibility">
        <span class="oem-metrics-bento__visibility-value">100%</span>
        <p class="oem-metrics-bento__visibility-text">видимость рекламы на площадках</p>
      </div>

      <div class="oem-metrics-bento__cell oem-metrics-bento__cell--reach">
        <span class="oem-metrics-bento__reach-value">50М</span>
        <p class="oem-metrics-bento__reach-lead">охват пользователей</p>
        <p class="oem-metrics-bento__reach-note">
          Контроль охвата, отсутствие блокировщиков рекламы
        </p>
      </div>

      <div class="oem-metrics-bento__cell oem-metrics-bento__cell--placeholder">
        <div class="oem-metrics-bento__placeholder-inner">
          <div class="oem-metrics-bento__placeholder-bars" aria-hidden="true">
            <span class="oem-metrics-bento__placeholder-bar"></span>
            <span class="oem-metrics-bento__placeholder-bar oem-metrics-bento__placeholder-bar--short"></span>
            <span class="oem-metrics-bento__placeholder-bar"></span>
            <span class="oem-metrics-bento__placeholder-bar"></span>
            <span class="oem-metrics-bento__placeholder-bar"></span>
          </div>
          <p class="oem-metrics-bento__placeholder-text">Здесь нужен текст</p>
        </div>
      </div>
    </div>
  </div>
</section>
